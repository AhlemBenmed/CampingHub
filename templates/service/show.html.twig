                    </ul>
                    <a class='menu-trigger'>
                        <span>Menu</span>
                    </a>

                </nav>
            </div>
        </div>
    </div>
</header>

<div class="page-heading-shows-events">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h2>services</h2>

            </div>
        </div>
    </div>
</div>
<!-- ***** Header Area End ***** -->
<!-- *** Venues & Tickets ***-->
<div class="venue-tickets">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="heading-tabs" style="text-align: right; margin-top: 20px;margin-right: 20px;">
                    <div class="row" style="justify-content: right; display: flex;">
                        <div class="main-dark-button" style="display: inline-block;">
                            <a href="{{ path('app_service_new', {'center_id': center_id})  }}">ADD A service</a>
                        </div>
                    </div>
                </div>
            </div>
            {% for service in services %}
                <div class="col-lg-4">
                    <div class="venue-item">
                        <div class="down-content">
                            <div class="right-content">
                                <h4>{{ service.name }}</h4>
                                <p>{{ service.center.name }}</p>
                                <ul>
                                    <li><i class="fa fa-arrow-right"></i>Description: {{ service.description }} </li>
                                </ul>
                                <div class="price">
                                    <span>Availability: <em>{{ service.availability }} </em></span><br>

                                </div>
                            </div>
                        </div>
                    </div>
                    <center><div class="main-dark-button" >
                            <a href="{{ path('app_service_edit', {'id': service.id ,'center_id': center_id}) }}" class="btn btn-primary">
                                <i class="fa fa-edit"></i>Edit</a>
                        </div>
                    </center>
                </div>

            {% else %}
                <div class="col-lg-12">
                    <p>No activities found.</p>
                </div>
            {% endfor %}
        </div>
    </div>
</div>

