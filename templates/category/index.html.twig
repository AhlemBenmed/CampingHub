<body>
<div id="js-preloader" class="js-preloader">
    <div class="preloader-inner">
        <span class="dot"></span>
        <div class="dots">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>
</div>

<div class="pre-header">
    <div class="container">
        <div class="row">
            <div class="col-lg-6 col-sm-6">
                <span>Hey! The Show Is Starting In 5 Days.</span>
            </div>
            <div class="col-lg-6 col-sm-6">
                <div class="text-button">
                    <a href="rent-venue.html.twig">Contact Us Now <i class="fa fa-arrow-right"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>


<header class="header-area header-sticky">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <nav class="main-nav">

                    <a href="oldindex.html.twig" class="logo">Camping<em>HUB</em></a>

                    <ul class="nav">
                        <li><a href="{{ asset('index.html.twig') }}">Home</a></li>
                        <li><a href="{{ asset('about.html.twig') }}">About Us</a></li>
                        <li><a href="{{ asset('rent-venue.html.twig') }}">Rent Venue</a></li>
                        <li><a class="active">Events</a></li>
                        <li><a href="{{ asset('center') }}" >Centers</a></li>
                    </ul>
                    <a class='menu-trigger'>
                        <span>Menu</span>
                    </a>

                </nav>
            </div>
        </div>
    </div>
</header>

<div class="page-heading-shows-events">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h2>Categories</h2>

            </div>
        </div>
    </div>
</div>

<div class="shows-events-tabs">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="row" id="tabs">
                    <div class="col-lg-12">
                        <div class="heading-tabs">
                            <div class="row">
                                <div class="col-lg-8">
                                    <ul></ul>
                                </div>
                                <div class="col-lg-4">
                                    <div class="main-dark-button">
                                        <a href="{{ path('app_event_new') }}">Add Category</a>
                                    </div>
                                </div>
                                {# <div class="col-lg-4">
                                          <div class="main-dark-button">
                                              <a href="ticket-details.html.twig">Purchase Tickets</a>
                                          </div>
                                    </div>#}
                            </div>
                        </div>
                    </div>
                    <div class="col-lg-12">
                        <section class='tabs-content'>
                            <article id='tabs-1'>
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="row">
                                            <div class="col-lg-12">
                                                {% for category in categories %}
                                                    <div class="event-item">
                                                        <div class="row">
                                                            <div class="col-lg-6">
                                                                <div class="left-content">
                                                                    <h4>{{ category.name }}</h4>
                                                                </div>
                                                            </div>

                                                            <div class="col-lg-6">
                                                                <div class="right-content">
                                                                    <div class="actions">
                                                                        <a href="{{ path('app_category_edit', {'id': category.id}) }}" class="btn btn-primary">
                                                                            <i class="fa fa-edit"></i> Edit
                                                                        </a>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                {% endfor %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </article>
                        </section>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="subscribe">
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <h4>Subscribe Our Newsletter:</h4>
            </div>
            <div class="col-lg-8">
                <form id="subscribe" action="" method="get">
                    <div class="row">
                        <div class="col-lg-9">
                            <fieldset>
                                <input name="email" type="text" id="email" pattern="[^ @]*@[^ @]*" placeholder="Your Email Address" required="">
                            </fieldset>
                        </div>
                        <div class="col-lg-3">
                            <fieldset>
                                <button type="submit" id="form-submit" class="main-dark-button">Submit</button>
                            </fieldset>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


