<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="description" content="">
    <meta name="author" content="Tooplate">
    <link href="https://fonts.googleapis.com/css?family=Poppins:100,100i,200,200i,300,300i,400,400i,500,500i,600,600i,700,700i,800,800i,900,900i&display=swap" rel="stylesheet">

    <title>Activities for Center </title>

    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/bootstrap.min.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/font-awesome.css') }}">
    <link rel="stylesheet" type="text/css" href="{{ asset('assets/css/owl-carousel.css') }}">
    <link rel="stylesheet" href="{{ asset('assets/css/tooplate-artxibition.css') }}">
</head>

<body>
<div id="js-preloader" class="js-preloader">
    <div class="preloader-inner">
        <span class="dot"></span>
        <div class="dots">
            <span></span>
            <span></span>
            <span></span>
        </div>
    </div>
</div>

<header class="header-area header-sticky">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <nav class="main-nav">
                    <a href="index.html.twig" class="logo">Camping<em>HUB</em></a>
                    <ul class="nav">
                        <li><a href="{{ asset('index.html.twig') }}">Home</a></li>
                        <li><a href="{{ asset('about.html.twig') }}">About Us</a></li>
                        <li><a href="{{ asset('rent-venue.html.twig') }}">Rent Venue</a></li>
                        <li><a class="active">Events</a></li>
                        <li><a href="{{ asset('center') }}">Centers</a></li>
                    </ul>
                    <a class='menu-trigger'>
                        <span>Menu</span>
                    </a>
                </nav>
            </div>
        </div>
    </div>
</header>

<div class="page-heading-shows-events">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <h2>Activities for Center </h2>
            </div>
        </div>
    </div>
</div>

<div class="venue-tickets">
    <div class="container-fluid">
        <div class="row">
            {% for activity in activities %}
                <div class="col-lg-4">
                    <div class="venue-item">
                        <div class="down-content">
                            <h4>{{ activity.name }}</h4>
                            <p>{{ activity.description }}</p>
                            <ul>
                                <li>When:
                                    {% if activity.specificDate is not null %}
                                        {{ activity.specificDate|date('Y-m-d') }}
                                    {% elseif activity.dayOfWeek is not null %}
                                        {{ activity.dayOfWeek }}
                                    {% else %}
                                        No valid date available
                                    {% endif %}
                                </li>
                            </ul>
                            <div class="price">
                                <span>From <em>{{ activity.timeStart|date('g:i A') }}</em></span><br>
                                <span>To <em>{{ activity.timeEnd|date('g:i A') }}</em></span>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <p>No activities found for this center.</p>
            {% endfor %}
        </div>
    </div>
</div>


<footer>
    <div class="col-lg-12">
        <div class="sub-footer">
            <div class="row">
                <div class="col-lg-3">
                    <div class="logo"><span>Camping<em>HUB</em></span></div>
                </div>
                <div class="col-lg-6">
                    <div class="menu">
                        <ul>
                            <li><a href="index.html" class="active">Home</a></li>
                            <li><a href="about.html">About Us</a></li>
                            <li><a href="rent-venue.html">Rent Venue</a></li>
                            <li><a href="shows-events.html">Shows & Events</a></li>
                            <li><a href="tickets.html">Tickets</a></li>
                        </ul>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="social-links">
                        <ul>
                            <li><a href="#"><i class="fa fa-twitter"></i></a></li>
                            <li><a href="#"><i class="fa fa-facebook"></i></a></li>
                            <li><a href="#"><i class="fa fa-behance"></i></a></li>
                            <li><a href="#"><i class="fa fa-instagram"></i></a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</footer>
</body>
</html>
