{% extends 'base.html.twig' %}

{% block title %}Activity{% endblock %}

{% block body %}
    <h1>Activity</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ activity.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ activity.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ activity.description }}</td>
            </tr>
            <tr>
                <th>TimeStart</th>
                <td>{{ activity.timeStart ? activity.timeStart|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>TimeEnd</th>
                <td>{{ activity.timeEnd ? activity.timeEnd|date('H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DayOfWeek</th>
                <td>{{ activity.dayOfWeek }}</td>
            </tr>
            <tr>
                <th>SpecificDate</th>
                <td>{{ activity.specificDate ? activity.specificDate|date('Y-m-d') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_activity_index') }}">back to list</a>

    <a href="{{ path('app_activity_edit', {'id': activity.id}) }}">edit</a>

    {{ include('activity/_delete_form.html.twig') }}
{% endblock %}
