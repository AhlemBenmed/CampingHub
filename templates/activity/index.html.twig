<!-- *** Venues & Tickets ***-->
<div class="venue-tickets">
    <div class="container-fluid">
        <div class="row">
            <div class="col-lg-12">
                <div class="section-heading">
                    <h2>Our Venues & Tickets</h2>
                </div>
                <div class="heading-tabs" style="text-align: right; margin-top: 20px;margin-right: 20px;">
                    <div class="row" style="justify-content: right; display: flex;">
                        <div class="main-dark-button" style="display: inline-block;">
                            <a href="{{ path('app_activity_new') }}">ADD A Activity</a>
                        </div>
                    </div>
                </div>
            </div>
            {% for activity in activities %}
            <div class="col-lg-4">
                <div class="venue-item">
                    <div class="down-content">
                        <div class="left-content">
                            <div class="main-white-button">
                                <a href="ticket-details.html">Center Name</a>
                            </div>
                        </div>
                        <div class="right-content">
                            <h4>{{ activity.name }}</h4>
                            <p>{{ activity.description }}</p>
                            <ul>
                                <li><i class="fa fa-arrow-right"></i>When: {% if activity.getSpecificDate() is not null %}
                                        {{ activity.getSpecificDate()|date('Y-m-d') }}  {# Displays the full day of the week for specificDate #}
                                    {% elseif activity.getDayOfWeek() is not null %}
                                        {{ activity.getDayOfWeek() }}  {# Displays the day of the week stored in dayOfWeek #}
                                    {% else %}
                                        {{ "No valid date available" }}
                                    {% endif %}</li>
                            </ul>
                            <div class="price">
                                <span>From <em>{{ activity.getTimeStart()|date('g:i A') }} </em></span><br>
                                <span>To <em>{{ activity.getTimeEnd()|date('g:i A') }}</em></span>
                            </div>
                        </div>
                    </div>
                </div>
                <center><div class="main-dark-button" >
                    <a href="{{ path('app_activity_edit', {'id': activity.id}) }}" class="btn btn-primary">
                        <i class="fa fa-edit"></i>Edit</a>
                </div>
                </center>
            </div>

            {% else %}
                <div class="col-lg-12">
                    <p>No activities found.</p>
                </div>
            {% endfor %}
    </div>
    </div>
</div>

