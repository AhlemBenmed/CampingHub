{% extends 'base.html.twig' %}

{% block title %}Registration{% endblock %}

{% block body %}
    <h1>Registration</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ registration.id }}</td>
            </tr>
            <tr>
                <th>RegistrationDate</th>
                <td>{{ registration.registrationDate ? registration.registrationDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ registration.status }}</td>
            </tr>
            <tr>
                <th>PaymentMethod</th>
                <td>{{ registration.paymentMethod ? registration.paymentMethod|join(', ') : '' }}</td>
            </tr>
            <tr>
                <th>PaymentStatus</th>
                <td>{{ registration.paymentStatus }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_registration_index') }}">back to list</a>

    <a href="{{ path('app_registration_edit', {'id': registration.id}) }}">edit</a>

    {{ include('registration/_delete_form.html.twig') }}
{% endblock %}
