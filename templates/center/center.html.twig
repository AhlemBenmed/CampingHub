    <!-- jQuery -->
    <script>
        const citiesByGovernorate = {
            Tunis: ["Bab El Bhar", "Carthage", "El Menzah", "El Omrane", "El Kabaria", "La Marsa"],
            Ariana: ["Raoued", "Sidi Thabet", "Ettadhamen", "Ariana Ville", "Mnihla"],
            BenArous: ["Hammam Lif", "Rades", "Mornag", "Megrine", "Ezzahra", "Boumhel Bassatine"],
            Manouba: ["Douar Hicher", "Oued Ellil", "Mornaguia", "El Battan", "Tebourba"],
            Nabeul: ["Hammamet", "Korba", "Dar Chaabane", "Kelibia", "Menzel Temime"],
            Zaghouan: ["Zaghouan", "Zriba", "Bir Mcherga", "El Fahs", "Nadhour"],
            Bizerte: ["Bizerte Nord", "Bizerte Sud", "Menzel Bourguiba", "Ras Jebel", "Sejnane"],
            Beja: ["Beja Nord", "Beja Sud", "Testour", "Teboursouk"],
            Jendouba: ["Jendouba Ville", "Boussalem", "Tabarka", "Ain Draham"],
            Kef: ["Kef Ville", "Nebeur", "Tajerouine"],
            Siliana: ["Siliana Nord", "Makthar", "Bouarada"],
            Sousse: ["Sousse Ville", "Akouda", "Hammam Sousse"],
            Monastir: ["Monastir Ville", "Ksar Hellal", "Sahline"],
            Mahdia: ["Mahdia Ville", "Ksour Essef", "Chebba"],
            Sfax: ["Sfax Ville", "El Ain", "Thyna"],
            Kairouan: ["Kairouan Ville", "Hajeb El Ayoun", "Chebika"],
            Kasserine: ["Kasserine Ville", "Thala", "Sbiba"],
            SidiBouzid: ["Sidi Bouzid Ville", "Jilma", "Meknassy"],
            Gabes: ["Gabes Ville", "Matmata", "Mareth"],
            Medenine: ["Medenine Ville", "Houmt Souk", "Zarzis"],
            Tataouine: ["Tataouine Ville", "Bir Lahmar", "Smar"],
            Gafsa: ["Gafsa Ville", "El Guettar", "Mdhilla"],
            Tozeur: ["Tozeur Ville", "Degache", "Nefta"],
            Kebili: ["Kebili Ville", "Douz", "El Faouar"]
        };

        const governorateSelect = document.getElementById("governorate");
        const citySelect = document.getElementById("city");

        governorateSelect.addEventListener("change", function () {
            const selectedGovernorate = this.value;
            citySelect.innerHTML = '<option value="">Select City</option>'; // Reset city dropdown

            if (citiesByGovernorate[selectedGovernorate]) {
                citiesByGovernorate[selectedGovernorate].forEach(city => {
                    const option = document.createElement("option");
                    option.value = city;
                    option.textContent = city;
                    citySelect.appendChild(option);
                });
            }
        });
    </script>
