{% extends 'base.html.twig' %}

{% block title %}Center{% endblock %}

{% block body %}
    <h1>Center</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ center.id }}</td>
            </tr>
            <tr>
                <th>Name</th>
                <td>{{ center.name }}</td>
            </tr>
            <tr>
                <th>Location</th>
                <td>{{ center.location }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ center.description }}</td>
            </tr>
            <tr>
                <th>Phone</th>
                <td>{{ center.phone }}</td>
            </tr>
            <tr>
                <th>Email</th>
                <td>{{ center.email }}</td>
            </tr>
            <tr>
                <th>Capacity</th>
                <td>{{ center.capacity }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_center_index') }}">back to list</a>

    <a href="{{ path('app_center_edit', {'id': center.id}) }}">edit</a>

    {{ include('center/_delete_form.html.twig') }}
{% endblock %}
