<!-- Leaflet JS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

<script>
    // Initialize the map
    const map = L.map('map').setView([parseFloat('{{ center.latitude }}'), parseFloat('{{ center.longitude }}')], 6);

    // Add OpenStreetMap tiles
    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '© OpenStreetMap contributors'
    }).addTo(map);

    // Add a marker for the center
    L.marker([parseFloat('{{ center.latitude }}'), parseFloat('{{ center.longitude }}')])
        .addTo(map)
        .bindPopup("<b>{{ center.name }}</b><br>{{ center.location }}")
        .openPopup();
</script>
